# Trading Server Configuration

# Server Settings
# Bind loopback only - this service places real orders. Do not expose it to
# the internet; the Discord bot reaches it over localhost.
HOST=127.0.0.1
PORT=8000

# REQUIRED - API Authentication (shared secret, must match the Discord bot's
# TRADING_SERVER_API_KEY). The server refuses to start while this is unset and
# refuses every request with 503. Generate one with: openssl rand -hex 32
API_KEY=change_this_to_secure_random_string

# BloFin API Credentials
BLOFIN_API_KEY=your_blofin_api_key
BLOFIN_SECRET_KEY=your_blofin_secret_key
BLOFIN_PASSPHRASE=your_blofin_passphrase

# BloFin Environment (production or demo)
# Production: https://openapi.blofin.com
# Demo: https://demo-trading-openapi.blofin.com
BLOFIN_BASE_URL=https://demo-trading-openapi.blofin.com

# Trading Configuration
DEFAULT_TRADE_MODE=cross  # cross or isolated
DEFAULT_LEVERAGE=10
MAX_POSITION_SIZE_USD=1000  # Maximum position size in USD
RISK_PER_TRADE_PERCENT=1  # Percentage of account balance to risk per trade

# Rate Limiting
MAX_ORDERS_PER_MINUTE=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=trading_server.log

# Database (optional - for trade history)
# DATABASE_URL=sqlite:///trades.db
