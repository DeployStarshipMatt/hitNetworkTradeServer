# Discord Bot Configuration
#
# Copy to .env and fill in real values. NEVER commit real credentials here -
# this file is tracked in a public repository.

# Discord Client ID
DISCORD_CLIENT_ID=your_discord_client_id_here

# Discord Bot Token (from discord.com/developers)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord OAuth2 URL to invite bot to your server
# Use this URL to add the bot: https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=68608&scope=bot

# Discord Channel ID to monitor (right-click channel > Copy ID with Developer Mode enabled)
DISCORD_CHANNEL_ID=your_channel_id_here

# Trading Server URL (loopback - both services run on the same host)
TRADING_SERVER_URL=http://127.0.0.1:8000

# REQUIRED - Trading Server API Key (shared secret between bot and server).
# Must be identical to API_KEY in trading-server/.env or every signal 401s.
# Generate one with: openssl rand -hex 32
TRADING_SERVER_API_KEY=same_value_as_trading_server_API_KEY

# REQUIRED - signal poster authorization (fails closed).
# Set at least one of these two. With both empty the bot refuses to start and
# no poster is authorized. A signal accepted from the monitored channel places
# a real order on the copy-trading master account, which followers auto-mirror.
ALLOWED_USER_IDS=comma_separated_discord_user_ids_here
REQUIRED_ROLE_NAME=

# Logging
LOG_LEVEL=INFO
LOG_FILE=discord_bot.log
